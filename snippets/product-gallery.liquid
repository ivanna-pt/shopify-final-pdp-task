{% comment %}
  Renders a product gallery with main image and thumbnails.
  Accepts:
  - product: {Object} Product Liquid object
  - enable_image_badges: {Boolean} Whether to show image badges (optional)

  Usage:
  {% render 'product-gallery', product: product, enable_image_badges: true %}
{% endcomment %}
{% style %}
  .swiper-carousel--thumbnails {
    display: block;
    overflow: hidden;
    height: 100%;
  }
  .swiper-carousel--thumbnails .swiper-container {
    height: 100%;
    width: 100%;
  }
  .swiper-carousel--thumbnails .swiper-slide {
    width: auto;
    height: auto;
  }

  @media (min-width: 1200px) {
    .swiper-carousel--thumbnails {
      height: 536px;
    }
  }
{% endstyle %}

<product-gallery>
  <div
    class="flex flex-col xl:flex-row-reverse gap-6"
    data-product-images
  >
    <div class="relative aspect-square" data-main-image>
      {% if enable_image_badges == true %}
        {% render 'product-badges', product: product %}
      {% endif %}
      {% assign featured_image_alt = product.featured_image.alt | default: product.title | escape %}

      {% assign main_image_classes = 'aspect-square object-cover rounded-lg' %}
      {% if product.featured_image %}
        {{
          product.featured_image
          | image_url: width: 536
          | image_tag:
            width: 536,
            height: 536,
            alt: featured_image_alt,
            class: main_image_classes,
            sizes: '(max-width: 600px) 100vw, 536px',
            fetchpriority: 'high'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg-class' }}
      {% endif %}
    </div>

    <swiper-carousel
      class="swiper-carousel--thumbnails"
      data-gallery-thumbs
    >
      <div
        class="swiper-container"
        role="group"
        aria-roledescription="carousel"
        aria-label="Main product images thumbnails"
      >
        <ul class="swiper-wrapper">
          {% for image in product.images %}
            {% assign image_alt = image.alt | default: product.title | escape %}
            {%- assign image_data_large = image | image_url: width: 536 -%}
            {%- capture image_data_srcset -%}
                    {{ image | image_url: width: 200 }} 200w, {{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w                  
              {%- endcapture -%}
            {%- assign image_data_sizes = '(max-width: 600px) 100vw, 536px' -%}
            <li class="swiper-slide">
              <div
                class="relative aspect-square overflow-hidden rounded-lg w-full h-full {% if forloop.first %}active{% endif %}"
                data-gallery-item
              >
                {{
                  image
                  | image_url: width: 136
                  | image_tag:
                    width: 88,
                    height: 88,
                    alt: image_alt,
                    class: 'object-cover w-full h-full lazy-image',
                    sizes: '88px',
                    loading: 'lazy',
                    data-gallery-thumb: true,
                    data-large: image_data_large,
                    data-srcset: image_data_srcset,
                    data-sizes: image_data_sizes
                }}
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
      <script type="application/json" class="swiper-config">
        {
          "slidesPerView": "auto",
          "spaceBetween": 16,
          "direction": "horizontal",
          "breakpoints": {
            "1200": {
              "direction": "vertical"
            }
          },
          "navigation": {
            "enabled": false
          },
          "watchOverflow": true
        }
      </script>
    </swiper-carousel>
  </div>
</product-gallery>
