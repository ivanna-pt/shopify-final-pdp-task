{% comment %}
  Renders 'icon_with_text' snippet
   Input:
     - items: an array of objects with 'icon_name' and 'text' properties
{% endcomment %}
{% if items != blank %}
  <ul class="my-6">
    {% for item in items %}
      <li class="mt-3 first:mt-0">
        <div class="flex items-center space-x-1.5 mb-4">
          {% if item.icon_name != blank %}
            <span class="text-scheme tw-5 h-5 shrink-0" aria-hidden="true">
              {{ item.icon_name | inline_asset_content }}
            </span>
          {% endif %}
          {% if item.text != blank %}
            <span class="body-md text-scheme">
              {{ item.text }}
            </span>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
{% endif %}
