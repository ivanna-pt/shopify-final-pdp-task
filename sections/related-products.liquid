{{ 'component-swiper-carousel.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div
    class="page-width"
  >
    {% if template contains 'product' and section.settings.collection == blank %}
      <related-products
        data-url="{{ routes.product_recommendations_url }}"
        data-limit={{ section.settings.limit }}
        data-product-id="{{ product.id }}"
        data-section-id="{{ section.id }}"
      >
        {%- if recommendations.performed? and recommendations.products_count > 0 -%}
          {% if section.settings.title != blank %}
            <h2 class="h2 text-center mb-9 md:mb-12">
              {{ section.settings.title }}
            </h2>
          {% endif %}
          <swiper-carousel class="product-recommendations-swiper relative">
            <script type="application/json" class="swiper-config">
              {
                "slidesPerView": 1.2,
                "spaceBetween": 16,
                "grid": {
                  "rows": 1,
                  "fill": "row"
                },
                "navigation": {
                  "enabled": true
                },
                "breakpoints": {
                  "480": {
                    "slidesPerView": 2,
                    "spaceBetween": 16
                  },
                  "768": {
                    "slidesPerView": 3,
                    "spaceBetween": 20
                  },
                  "1200": {
                    "slidesPerView": 4,
                    "spaceBetween": 24
                  }
                },
                "watchOverflow": true
              }
            </script>
            <div
              class="swiper-container"
              role="group"
              aria-roledescription="carousel"
              aria-label="Related products"
            >
              <ul class="swiper-wrapper">
                {%- for recommended_product in recommendations.products -%}
                  <li class="swiper-slide">
                    {% render 'card-product', card_product: recommended_product %}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
            <div class="swiper-button-prev-custom" role="button" aria-label="Next Slide">
              {{ 'arrow-btn.svg' | inline_asset_content }}
            </div>
            <div class="swiper-button-next-custom" role="button" aria-label="Prev Slide">
              {{ 'arrow-btn.svg' | inline_asset_content }}
            </div>
          </swiper-carousel>
        {% else %}
          <div class="max-w-xl mx-auto">
            <p class="body-lg text-center text-gray-600">
              {{ 'sections.related-products.no_products' | t }}
            </p>
          </div>
        {% endif %}
      </related-products>
    {% elsif section.settings.collection != blank %}
      {% if section.settings.title != blank %}
        <h2 class="h2 text-center mb-9 md:mb-12">
          {{ section.settings.title }}
        </h2>
      {% endif %}
      <swiper-carousel class="product-recommendations-swiper relative">
        <script type="application/json" class="swiper-config">
          {
            "slidesPerView": 1.2,
            "spaceBetween": 16,
            "grid": {
              "rows": 1,
              "fill": "row"
            },
            "navigation": {
              "enabled": true
            },
            "breakpoints": {
              "480": {
                "slidesPerView": 2,
                "spaceBetween": 16
              },
              "768": {
                "slidesPerView": 3,
                "spaceBetween": 20
              },
              "1200": {
                "slidesPerView": 4,
                "spaceBetween": 24
              }
            },
            "watchOverflow": true
          }
        </script>
        <div
          class="swiper-container"
          role="group"
          aria-roledescription="carousel"
          aria-label="Related products"
        >
          <ul class="swiper-wrapper">
            {%- for product_item in section.settings.collection.products -%}
              <li class="swiper-slide">
                {% render 'card-product', card_product: product_item %}
              </li>
            {%- endfor -%}
          </ul>
        </div>
        <div class="swiper-button-prev-custom" role="button" aria-label="Next Slide">
          {{ 'arrow-btn.svg' | inline_asset_content }}
        </div>
        <div class="swiper-button-next-custom" role="button" aria-label="Prev Slide">
          {{ 'arrow-btn.svg' | inline_asset_content }}
        </div>
      </swiper-carousel>
    {% else %}
      <div class="max-w-xl mx-auto">
        <p class="body-lg text-center text-gray-600">
          {{ 'sections.related-products.no_products' | t }}
        </p>
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Related Products",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select featured collection"
    },
    {
      "type": "text",
      "id": "title",
      "default": "You may also like",
      "label": "Section title"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "default": 4,
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
