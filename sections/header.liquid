<script src="{{ 'header-handler.js' | asset_url }}" defer="defer"></script>

<header>
  <nav class="nav w-full" aria-label="{{ 'general.accessibility.main_navigation' | t }}">
    <div class="page-width container">
      <a href="{{ routes.root_url }}" class="nav-logo">
        {% assign logo = settings.logo | default: shop.brand.logo %}
        {% assign logo_width = 100 %}
        {% assign logo_height = 24 %}
        {% if logo != 'blank' %}
          {{
            logo
            | image_url: width: logo_width, height: logo_height
            | image_tag: alt: shop.name, width: logo_width, height: logo_height
          }}
        {% else %}
          <span class="h2">{{ shop.name }}</span>
        {% endif %}
      </a>
      <button
        class="nav-toggler"
        aria-label="{{ 'general.accessibility.toggle_navigation' | t }}"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        {{ 'navbar-toggler.svg' | inline_asset_content }}
      </button>
      <a href="{{ routes.cart_url }}" class="nav-cart" aria-label="{{ 'general.accessibility.cart' | t }}">
        {% assign cart_icon = 'cart-icon.svg' %}
        {%- if cart_icon != 'blank' -%}
          {{ 'cart-icon.svg' | inline_asset_content }}
        {%- else -%}
          <span>{{ 'sections.header.cart' | t }}</span>
        {%- endif -%}
        {% comment %} <span>({{ cart.item_count }})</span> {% endcomment %}
      </a>
      {% render 'header-menu' %}
    </div>
  </nav>
  {% comment %}
    <h2 class="header__title">
      {{ shop.name | link_to: routes.root_url }}
    </h2>

    <div class="header__menu">
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    </div>

    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        {{ 'icon-account.svg' | inline_asset_content | link_to: routes.account_url }}
      {% endif %}

      <a href="{{ routes.cart_url }}">
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}

        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  {% endcomment %}
</header>

{% stylesheet %}
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: var(--color-white);
    transition: transform 0.3s ease;
    z-index: 999;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  header.hidden {
    transform: translateY(-100%);
  }
  .nav {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .nav > .container {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav .nav-logo {
    display: none;
  }

  .nav .nav-cart {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-toggler {
    background-color: transparent;
    border: 1px solid transparent;
  }

  .nav svg {
    flex-shrink: 0;
  }

  .nav .nav-list {
    flex-grow: 1;
    flex-basis: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: opacity 0.3s ease-in, max-height 0.3s ease-in;
  }

  .nav.show .nav-list {
    margin-top: 1.5rem;
    opacity: 1;
    overflow: visible;
  }

  .nav .nav-list .nav-link {
    position: relative;
    width: 100%;
  }

  .nav .nav-list .nav-link:before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0;
    background-color: var(--text-primary);
    transition: 0.3s;
  }
  .nav .nav-list .nav-link.active:before,
  .nav .nav-list .nav-link:hover:before {
    width: 100%;
  }
  @media (min-width: 768px) {
    .nav {
      padding-top: 30px;
      padding-bottom: 30px;
    }
    .nav .nav-logo {
      display: block;
    }
    .nav .nav-toggler {
      display: none;
    }
    .nav .nav-list {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      max-height: max-content;
      opacity: 1;
      overflow: visible;
      margin-top: 0;
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
