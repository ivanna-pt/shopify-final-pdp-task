{%- liquid
  assign target = product.selected_or_first_available_variant
-%}

<product-info
  class="section-{{ section.id }}-padding block"
  id="MainProduct-{{ section.id }}"
  data-selected-variant-id="{{ target.id }}"
  data-product-handle="{{ product.handle }}"
>
  {%- style -%}
    .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
        }
      }
  {%- endstyle -%}
  <div class="page-width">
    <div class="flex flex-col md:flex-row  gap-8">
      <div class="lg:sticky lg:top-6 self-start md:flex-1">
        {% render 'product-gallery', product: product, enable_image_badges: section.settings.enable_image_badges %}
      </div>
      <div class="md:flex-1">
        {%- assign product_form_id = 'product-form-' | append: section.id -%}
        {% for block in section.blocks %}
          {% case block.type %}
            {%- when '@app' -%}
              {% render block %}
            {% when 'title' %}
              <h2 class="text-2xl! md:text-3xl font-normal!">{{ product.title | escape }}</h2>
            {% when 'price' %}
              {% render 'price',
                product: product,
                show_badges: true,
                show_compare_at_price: true,
                price_class: 'main-product'
              %}
            {% when 'description' %}
              {% if product.description != blank %}
                <div
                  class="mt-6 text-gray-600 body-md"
                  aria-label="{{ 'products.product.description' | t }}"
                >
                  {{ product.description }}
                </div>
              {% endif %}
            {% when 'variant_picker' %}
              {% render 'product-variant-selector',
                product: product,
                section: section,
                product_form_id: product_form_id
              %}
            {% when 'quantity_selector' %}
              {% comment %} Quantity selector block {% endcomment %}
            {% when 'buy_buttons' %}
              {% render 'buy-buttons', product: product, section_id: section.id %}
            {% when 'collapsible_row' %}
              <div class="my-2">
                <details
                  class="accordion"
                  {% if block.settings.default_open %}
                    open
                  {% endif %}
                  name="Details-{{ section.id }}"
                >
                  <summary class="accordion-summary{% if block.settings.default_open %} active{% endif %}">
                    <h3 class="uppercase">{{ block.settings.title | escape }}</h3>
                    <span class="accordion-icon" aria-hidden="true"></span>
                  </summary>
                  <div class="accordion-content">
                    {{ block.settings.content }}
                  </div>
                </details>
              </div>
            {% when 'icon_with_text' %}
              {% comment %} Render 'icon_with_text' snippet {% endcomment %}
            {% when 'rating' %}
              {% comment %} Render 'product-rating' snippet {% endcomment %}
              {% liquid
                assign reviews = product.metafields.custom.reviews.value
                assign rating_sum = 0
                assign review_count = 0
                if reviews != blank
                  for review in reviews
                    assign rating_sum = rating_sum | plus: review.rating
                    assign review_count = review_count | plus: 1
                  endfor
                endif
                assign total_rating = rating_sum | divided_by: review_count | round: 1
              %}
              <div class="mt-2">
                {% render 'star-rating', rating: total_rating, , show_number: true %}
              </div>
            {% when 'text' %}
              <div class="mt-6">
                {{ block.settings.custom_text }}
              </div>
            {% when 'inventory' %}
              <div data-inventory-quantity>
                {%- unless target.available == false -%}
                  {% if target.inventory_management == 'shopify' and target.inventory_policy != 'continue' %}
                    <span class="font-semibold">
                      {{ 'products.product.inventory_in_stock_show_count' | t: quantity: target.inventory_quantity }}
                    </span>
                  {%- else -%}
                    <span class="font-semibold">
                      {{ 'products.product.inventory_in_stock' | t }}
                    </span>
                  {%- endif -%}
                {%- else -%}
                  <span class="text-red-600">{{ 'products.product.inventory_out_of_stock' | t }}</span>
                {%- endunless -%}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</product-info>

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Product Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Product Description",
      "limit": 1
    },
    {
      "type": "quantity_selector",
      "name": "Quantity Selector",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1
    },
    {
      "type": "inventory",
      "name": "Inventory",
      "limit": 1
    },
    {
      "type": "text",
      "name": "Custom Text",
      "settings": [
        {
          "type": "richtext",
          "id": "custom_text",
          "label": "Text",
          "default": "<p>Your custom text goes here.</p>"
        }
      ]
    },
    {
      "type": "icon_with_text",
      "name": "Icon with text",
      "settings": [
        {
          "type": "header",
          "content": "Pairing 1",
          "info": "Choose an icon or add an image for each pairing"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "heading_1",
          "default": "Heading",
          "label": "Heading",
          "info": "Leave blank to hide this pairing"
        },
        {
          "type": "header",
          "content": "Pairing 2"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "heading_2",
          "default": "Heading",
          "label": "Heading",
          "info": "Leave blank to hide this pairing"
        },
        {
          "type": "header",
          "content": "Pairing 3",
          "info": "Choose an icon or add an image for each pairing"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "heading_3",
          "default": "Heading",
          "label": "Heading",
          "info": "Leave blank to hide this pairing"
        }
      ]
    },
    {
      "type": "collapsible_row",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Accordion Title",
          "default": "Product Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Accordion Content",
          "default": "<p>Here you can add detailed information about the product.</p>"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_image_badges",
      "default": true,
      "label": "Enable image badges"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Main product"
    }
  ]
}
{% endschema %}
